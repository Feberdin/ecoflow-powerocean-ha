{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Feberdin/ecoflow-powerocean-ha/schemas/powerocean-observation.schema.json",
  "title": "EcoFlow PowerOcean Observation",
  "description": "Anonymisierter Messpunkt für EcoFlow PowerOcean Auswertungen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "purpose", "source", "measurements", "privacy"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "$ref": "#/$defs/purpose"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "description": "Anonyme Quellen-ID ohne Seriennummer, Namen oder E-Mail-Adresse."
        },
        "repo": {
          "type": "string",
          "description": "Optionales Quell-Repo, z. B. other-owner/other-repo."
        },
        "integration_version": {
          "type": "string"
        },
        "home_assistant_version": {
          "type": "string"
        },
        "device_model": {
          "type": "string"
        },
        "battery_packs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "power": {
          "$ref": "#/$defs/power"
        },
        "energy": {
          "$ref": "#/$defs/energy"
        },
        "battery": {
          "$ref": "#/$defs/battery"
        },
        "backup": {
          "$ref": "#/$defs/backup"
        },
        "daily_report": {
          "$ref": "#/$defs/daily_report"
        },
        "system_limits": {
          "$ref": "#/$defs/system_limits"
        }
      }
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "anonymized_entities": {
      "type": "array",
      "description": "Alle erkennbaren EcoFlow-/PowerOcean-States ohne vollständige Entity-IDs und ohne Anzeigenamen.",
      "items": {
        "$ref": "#/$defs/anonymized_entity"
      }
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redaction_level", "removed"],
      "properties": {
        "redaction_level": {
          "type": "string",
          "enum": ["entity_id_suffix_only"]
        },
        "state_redaction": {
          "type": "string",
          "enum": ["sensitive_values_redacted"]
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity_sources": {
      "type": "object",
      "description": "Anonymisierte Quellenhinweise: keine vollständigen Entity-IDs.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "matched_suffix"],
        "properties": {
          "domain": {
            "type": "string"
          },
          "matched_suffix": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optionale kurze Notiz ohne private Daten."
    }
  },
  "$defs": {
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent", "allowed_use", "not_allowed"],
      "properties": {
        "consent": {
          "type": "string",
          "enum": ["voluntary_user_supplied"]
        },
        "allowed_use": {
          "type": "string",
          "enum": ["improve_ecoflow_powerocean_integration_and_analysis_only"]
        },
        "not_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "number": {
      "type": "number"
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solar_power_w": { "$ref": "#/$defs/number" },
        "grid_power_w": {
          "type": "number",
          "description": "Positiv = Netzbezug, negativ = Einspeisung."
        },
        "load_power_w": { "$ref": "#/$defs/number" },
        "battery_power_w": {
          "type": "number",
          "description": "Positiv = Batterie entlädt, negativ = Batterie lädt."
        }
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solar_energy_kwh": { "type": "number", "minimum": 0 },
        "grid_import_energy_kwh": { "type": "number", "minimum": 0 },
        "grid_export_energy_kwh": { "type": "number", "minimum": 0 },
        "battery_discharge_energy_kwh": { "type": "number", "minimum": 0 },
        "battery_charge_energy_kwh": { "type": "number", "minimum": 0 }
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_soc_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "total_power_w": { "$ref": "#/$defs/number" },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index"],
            "properties": {
              "index": { "type": "integer", "minimum": 1, "maximum": 9 },
              "soc_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "soh_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "power_w": { "$ref": "#/$defs/number" },
              "remaining_energy_wh": { "type": "number", "minimum": 0 },
              "temperature_c": { "$ref": "#/$defs/number" },
              "cycles": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_estimate_minutes": { "type": "number", "minimum": 0 },
        "runtime_estimate_hours": { "type": "number", "minimum": 0 },
        "usable_energy_wh": { "type": "number", "minimum": 0 }
      }
    },
    "daily_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_export_energy_kwh": { "type": "number", "minimum": 0 },
        "total_value_eur": { "type": "number", "minimum": 0 },
        "total_battery_full_hours": { "type": "number", "minimum": 0 }
      }
    },
    "system_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "battery_charge_limit_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "battery_discharge_limit_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "backup_reserve_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "feed_in_power_w": { "$ref": "#/$defs/number" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connection_status": { "type": "string" },
        "system_power_state": { "type": "string", "enum": ["on", "off", "unknown"] },
        "work_mode": { "type": "string" },
        "work_state": { "type": "string" },
        "grid_status": { "type": "string" },
        "recommended_action": { "type": "string" },
        "backup_active": { "type": "boolean" },
        "power_outage": { "type": "boolean" },
        "backup_reserve_critical": { "type": "boolean" }
      }
    },
    "anonymized_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "suffix", "state"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["sensor", "binary_sensor", "button", "switch", "update"]
        },
        "suffix": {
          "type": "string",
          "description": "Nicht-personalisierter Suffix, z. B. netz_leistung."
        },
        "state": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "number" },
              { "type": "string" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          },
          "description": "Nur technische Attribute wie unit_of_measurement, device_class, state_class, entity_category oder icon."
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monthly": {
          "type": "object",
          "description": "Optionale monatliche HA-Langzeitstatistiken, anonymisiert nach Suffix.",
          "additionalProperties": {
            "$ref": "#/$defs/monthly_statistic"
          }
        }
      }
    },
    "monthly_statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "unit_of_measurement": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monthly_statistic_value"
          }
        }
      }
    },
    "monthly_statistic_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period"],
      "properties": {
        "period": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "sum": { "$ref": "#/$defs/number" },
        "delta": { "$ref": "#/$defs/number" },
        "mean": { "$ref": "#/$defs/number" },
        "min": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "backup_reserved_soc_percent": { "type": "integer", "minimum": 0, "maximum": 99 },
        "system_power_reserve_guard_enabled": { "type": "boolean" },
        "system_power_reserve_restart_margin_percent": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    }
  }
}
